{
  "compilerOptions": {
    "target": "ES2020",
    // "node16" module + moduleResolution below must be paired. Since this
    // package has no "type": "module" in package.json, TS treats every file
    // as CommonJS and emits CJS `require()` calls — same runtime behavior
    // as the previous `module: commonjs` setting, without the deprecation.
    "module": "node16",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // "node" / "node10" was deprecated in TS 5+ and is removed in TS 7.
    // "node16" is the modern equivalent for a Node.js target: for CJS files
    // (this project has no "type": "module" in package.json) extensionless
    // relative imports continue to work exactly as before.
    "moduleResolution": "node16",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
