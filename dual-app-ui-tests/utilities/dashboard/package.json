{
  "name": "maestro-automation-dashboard",
  "version": "1.0.0",
  "description": "Automation Dashboard for CVS Health Maestro UI Test Framework",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "electron": "ELECTRON_DEV=true electron .",
    "electron-dev": "concurrently --kill-others --names server,electron \"ELECTRON_DEV=true node server.js\" \"wait-on http://localhost:3003 && ELECTRON_DEV=true electron .\"",
    "electron-build": "electron-builder"
  },
  "dependencies": {
    "express": "^4.18.2",
    "react-scripts": "0.0.0",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^2.0.0",
    "wait-on": "^7.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "build": {
    "appId": "com.cvs.maestro.dashboard",
    "productName": "CVS Maestro Dashboard",
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "index.html",
      "styles/**/*",
      "js/**/*",
      "clipboard-utils.js",
      "package.json",
      "node_modules/express/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
