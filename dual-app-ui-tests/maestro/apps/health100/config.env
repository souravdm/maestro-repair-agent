# Health100 App Configuration
# This is the single source of truth for suite runs.
# Update BUILD_CONFIG and IOS_APP_ID together to match the installed build.
#
#  Adhoc build  → BUILD_CONFIG=adhoc   IOS_APP_ID=com.cvsenterpriseiphone.health100
#  Release build → BUILD_CONFIG=release  IOS_APP_ID=com.health100.h100.app
#
# Suite runner reads this file only — build_config.yaml is for local dev builds, not suites.

IOS_APP_ID=com.cvsenterpriseiphone.health100
ANDROID_APP_ID=com.health100.launchers
ANDROID_BUILD_VARIANT=healthRelease

APP_NAME=Health100
BRAND=health100

# Build configuration used to select credentials (debug→qa, adhoc/release→prod).
# Must match the build physically installed on the simulator/device.
BUILD_CONFIG=debug
