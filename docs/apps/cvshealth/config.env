# CVS Health App Configuration
# App identity only — environment (BUILD_CONFIG) is a runtime concern,
# passed via CLI or CI/CD parameters, not baked in here.
#
# Suite runner reads IOS_APP_ID or ANDROID_APP_ID based on --platform flag.
# Single test execution reads from build_config.yaml instead.

IOS_APP_ID=com.cvsenterpriseiphone.cvspharmacy
ANDROID_APP_ID=com.cvs.launchers.cvs
ANDROID_BUILD_VARIANT=shopDebug

APP_NAME="CVS Health"
BRAND=cvshealth
